# ---------- IDE / 构建 ----------
*.iml
.gradle
/local.properties
/.idea
/.kotlin
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# 模块构建产物
app/build/
app/release/
app/debug/

# 签名文件永远不要入库
*.jks
*.keystore
*.p12
!debug.keystore

# NDK / CMake 产物（P1b 引入 LibRaw 后会产生）
app/.cxx/
app/build/intermediates/cxx/

# ---------- 项目本地文件（不进 App 仓库） ----------
# WorkBuddy 项目记忆，属于本地工作区，不应进入代码仓库
.workbuddy/

# 历史规划文档归档（仅本地追溯用）
docs/archive/

# ---------- 本地样本（不入库） ----------
# Sony A7C II ARW 样本体积大，仅本地调试/真机验证用
example/

# ---------- 本地校验脚本残留（绝不入库） ----------
# 括号/花括号配平等一次性自检的输出文件（约定写到 $TEMP，历史上曾落在仓库根）
.*check.txt
.bracecheck.txt
.parencheck.txt

# ---------- 临时凭证 / CI 调试残留（绝不入库） ----------
# 覆盖所有 .ci_ 前缀产物：CI 日志抓取流程实际写出的是 .ci_ghtoken（无扩展名），
# 此前只忽略 .ci_token.txt / .ci_*.json，PAT 有入库风险（FIX_LIST F09）。
.ci_*
.ci_ghtoken
