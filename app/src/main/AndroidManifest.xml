<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 读取系统相册中的 JPEG / HEIF 等图片（Android 13+ 细分媒体权限） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14+（API 34）：用户仅授权"部分照片"时的访问权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <application
        android:name=".PixelCakeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PixelCake">

        <!--
          android:colorMode="hdr" 是广色域链路的第一环：
          请求系统以广色域（Display P3）合成并渲染该 Activity 的窗口。
          配合第 2 步的 RGBA16F 纹理与 EGL P3 配置，构成端到端广色域管线。

          screenOrientation="fullSensor"：看照片需要跟随重力四向旋转。
          Android 16 起系统会忽略"固定"方向的请求，但 fullSensor 走的是传感器
          自适应分支，在手机上仍生效；此处定向忽略 lint 的 DiscouragedApi。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PixelCake"
            android:windowSoftInputMode="adjustResize"
            android:colorMode="hdr"
            android:screenOrientation="fullSensor"
            tools:ignore="DiscouragedApi"
            android:configChanges="colorMode|screenSize|smallestScreenSize|screenLayout|orientation|density|uiMode">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 调试日志导出：把 files/debug 下的日志通过系统分享发出去 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
